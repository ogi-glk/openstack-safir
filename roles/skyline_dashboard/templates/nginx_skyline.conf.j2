upstream skyline {
    server 127.0.0.1:{{ skyline_apiserver_port }};
}

server {
    listen {{ skyline_web_port }};
    server_name _;

    root {{ skyline_console_dir }};
    index index.html index.htm;

    # 1. React SPA Frontend Routing
    location / {
        try_files $uri /index.html;
    }

    # 2. Keystone Direct Endpoints (Case-Insensitive Regex)
    location ~* ^/api/openstack/.*keystone/(.*)$ {
        proxy_pass {{ (skyline_keystone_url | default(keystone_auth_url) | regex_replace('/v3/?$', '')) }}/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 3. Skyline Backend API Route (Case-Insensitive Regex)
    location ~* ^/api/openstack/skyline/(.*)$ {
        proxy_pass http://skyline/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    # 4. General API Route
    location /api/ {
        proxy_pass http://skyline/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    access_log /var/log/nginx/skyline_access.log;
    error_log /var/log/nginx/skyline_error.log;
}

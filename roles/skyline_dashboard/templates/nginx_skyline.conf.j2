upstream skyline {
    server 127.0.0.1:{{ skyline_apiserver_port }};
}

server {
    listen {{ skyline_web_port }};
    server_name _;

    root {{ skyline_console_dir }};
    index index.html index.htm;

    # 1. React SPA Frontend Routing
    location / {
        try_files $uri /index.html;
    }

    # 2. Barbican & Non-installed Key Manager Graceful Fallback
    location ~* ^/(v1/secrets|api/openstack/[^/]+/barbican) {
        default_type application/json;
        return 200 '{"secrets":[],"total":0}';
    }

    # 3. OpenStack Keystone Identity API
    location ~* ^/api/openstack/[^/]+/keystone/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:5000/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 4. OpenStack Nova Compute API
    location ~* ^/api/openstack/[^/]+/nova/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:8774/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 5. OpenStack Cinder Block Storage API
    location ~* ^/api/openstack/[^/]+/cinder/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:8776/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 6. OpenStack Glance Image API
    location ~* ^/api/openstack/[^/]+/glance/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:9292/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 7. OpenStack Neutron Network API
    location ~* ^/api/openstack/[^/]+/neutron/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:9696/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 8. OpenStack Heat Orchestration API
    location ~* ^/api/openstack/[^/]+/heat/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:8004/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 9. OpenStack Placement API
    location ~* ^/api/openstack/[^/]+/placement/(.*)$ {
        proxy_pass http://{{ openstack_management_vip }}:8780/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_redirect off;
    }

    # 10. Skyline Backend API Route
    location ~* ^/api/openstack/skyline/(.*)$ {
        proxy_pass http://skyline/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    # 11. General Skyline API Route
    location /api/ {
        proxy_pass http://skyline/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    access_log /var/log/nginx/skyline_access.log;
    error_log /var/log/nginx/skyline_error.log;
}
